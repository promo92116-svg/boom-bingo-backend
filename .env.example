# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=boombingoo

# Leave empty for same-origin API (recommended with npm run dev)
# Set only if API runs on a separate host, e.g. https://api.example.com
VITE_API_ORIGIN=
